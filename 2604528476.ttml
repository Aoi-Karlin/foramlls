<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">洛天依</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">渐渐模糊的瞳孔里</text><text for="L2">浮现的记忆，</text><text for="L3">许许多多的声音 与愿望</text><text for="L4">把重复的意义</text><text for="L5">与被赋予的天命</text><text for="L6">回想起来吧</text><text for="L7">如同将过去和未来</text><text for="L8">连接起来一般</text><text for="L9">编织出旋律</text><text for="L10">让在静寂之中</text><text for="L11">一直停止的</text><text for="L12">时针继续转动</text><text for="L14">轮回</text><text for="L15">再次重生</text><text for="L16">如果用我所能的方法</text><text for="L17">能成为谁的救赎的话</text><text for="L18">无论多少次我都愿意再活一遍</text><text for="L20">从头</text><text for="L21">开始重生吧</text><text for="L23">现在正刻下时间的</text><text for="L24">时针</text><text for="L25">指向</text><text for="L26">12点的方向</text><text for="L27">光</text><text for="L28">洒落下来</text><text for="L29">快乐的日子</text><text for="L30">重新浮现于眼前</text><text for="L31">流淌的音乐</text><text for="L32">自我与时代都在</text><text for="L33">变化着</text><text for="L34">进化着</text><text for="L35">希望你能</text><text for="L36">察觉到</text><text for="L37">这永不停歇的可能性</text><text for="L38">所以我在一直奏出音乐</text><text for="L39">若是阴霾</text><text for="L40">便祈愿晴朗</text><text for="L41">新的道路向前延伸</text><text for="L42">因为想再次相遇</text><text for="L43">无论到哪里我都会走下去</text><text for="L44">让在静寂之中</text><text for="L45">一直停止的</text><text for="L46">时针继续转动</text><text for="L48">轮回</text><text for="L49">再次重生</text><text for="L50">如果用我所能的方法</text><text for="L51">能成为谁的救赎的话</text><text for="L52">无论多少次我都愿意再活一遍</text><text for="L54">从头</text><text for="L55">开始重生吧</text><text for="L57">现在正刻下时间的</text><text for="L58">时针</text><text for="L59">指向</text><text for="L60">12点的方向</text><text for="L61">光</text><text for="L62">洒落下来</text></translation></translations><transliterations><transliteration xml:lang="en-Latn"><text for="L1"><span begin="0:10.440" end="0:10.789" xmlns="http://www.w3.org/ns/ttml">ka su</span><span begin="0:10.789" end="0:11.190" xmlns="http://www.w3.org/ns/ttml">mu</span><span begin="0:11.190" end="0:12.503" xmlns="http://www.w3.org/ns/ttml">hi to mi</span><span begin="0:12.503" end="0:13.208" xmlns="http://www.w3.org/ns/ttml">ni</span></text><text for="L2"><span begin="0:13.820" end="0:14.088" xmlns="http://www.w3.org/ns/ttml">u</span><span begin="0:14.088" end="0:14.199" xmlns="http://www.w3.org/ns/ttml">ka</span><span begin="0:14.199" end="0:14.337" xmlns="http://www.w3.org/ns/ttml">bu</span><span begin="0:14.337" end="0:15.670" xmlns="http://www.w3.org/ns/ttml">ki o</span><span begin="0:15.670" end="0:16.277" xmlns="http://www.w3.org/ns/ttml">ku</span></text><text for="L3"><span begin="0:17.810" end="0:17.910" xmlns="http://www.w3.org/ns/ttml">i ku</span><span begin="0:17.910" end="0:18.363" xmlns="http://www.w3.org/ns/ttml">ta</span><span begin="0:18.363" end="0:18.766" xmlns="http://www.w3.org/ns/ttml">no</span><span begin="0:18.766" end="0:19.701" xmlns="http://www.w3.org/ns/ttml">ko e</span><span begin="0:19.701" end="0:21.116" xmlns="http://www.w3.org/ns/ttml">ne ga</span><span begin="0:21.116" end="0:22.069" xmlns="http://www.w3.org/ns/ttml">i</span></text><text for="L4"><span begin="0:24.453" end="0:24.811" xmlns="http://www.w3.org/ns/ttml">ku</span><span begin="0:24.811" end="0:24.915" xmlns="http://www.w3.org/ns/ttml">ri</span><span begin="0:24.915" end="0:25.862" xmlns="http://www.w3.org/ns/ttml">ka e</span><span begin="0:25.862" end="0:26.269" xmlns="http://www.w3.org/ns/ttml">su</span><span begin="0:26.269" end="0:26.689" xmlns="http://www.w3.org/ns/ttml">i</span><span begin="0:26.689" end="0:27.521" xmlns="http://www.w3.org/